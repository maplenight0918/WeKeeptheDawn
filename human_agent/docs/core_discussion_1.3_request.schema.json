{
  "$defs": {
    "Allocation": {
      "additionalProperties": false,
      "properties": {
        "plot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plot Id",
          "type": "string"
        },
        "water_quota_liters": {
          "minimum": 0,
          "title": "Water Quota Liters",
          "type": "number"
        },
        "power_quota_eu": {
          "minimum": 0,
          "title": "Power Quota Eu",
          "type": "number"
        }
      },
      "required": [
        "plot_id",
        "water_quota_liters",
        "power_quota_eu"
      ],
      "title": "Allocation",
      "type": "object"
    },
    "CoreCrew": {
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "alive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alive"
        },
        "food_energy": {
          "maximum": 3000,
          "minimum": 0,
          "title": "Food Energy",
          "type": "number"
        },
        "water": {
          "maximum": 2,
          "minimum": 0,
          "title": "Water",
          "type": "number"
        }
      },
      "required": [
        "id",
        "food_energy",
        "water"
      ],
      "title": "CoreCrew",
      "type": "object"
    },
    "CorePlot": {
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "growing",
            "mature",
            "dead"
          ],
          "title": "Status",
          "type": "string"
        },
        "crop_type": {
          "anyOf": [
            {
              "enum": [
                "lettuce",
                "potato",
                "tomato",
                "wheat",
                "soybean"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Crop Type"
        },
        "growth_ticks": {
          "minimum": 0,
          "title": "Growth Ticks",
          "type": "integer"
        },
        "consecutive_unirrigated_ticks": {
          "minimum": 0,
          "title": "Consecutive Unirrigated Ticks",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "status",
        "crop_type",
        "growth_ticks",
        "consecutive_unirrigated_ticks"
      ],
      "title": "CorePlot",
      "type": "object"
    },
    "CoreWorld": {
      "properties": {
        "world_version": {
          "minimum": 0,
          "title": "World Version",
          "type": "integer"
        },
        "rules_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rules Version",
          "type": "string"
        },
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        },
        "crew": {
          "items": {
            "$ref": "#/$defs/CoreCrew"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Crew",
          "type": "array"
        },
        "plots": {
          "items": {
            "$ref": "#/$defs/CorePlot"
          },
          "maxItems": 20,
          "minItems": 20,
          "title": "Plots",
          "type": "array"
        },
        "world_status": {
          "default": "planning",
          "enum": [
            "running",
            "paused",
            "planning",
            "error_paused",
            "failed"
          ],
          "title": "World Status",
          "type": "string"
        },
        "snapshot_phase": {
          "const": "between_ticks",
          "default": "between_ticks",
          "title": "Snapshot Phase",
          "type": "string"
        },
        "water_production_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Water Production Available"
        },
        "next_tick_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/Plan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "current_plan": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Plan"
        }
      },
      "required": [
        "world_version",
        "rules_version",
        "tick",
        "resources",
        "crew",
        "plots"
      ],
      "title": "CoreWorld",
      "type": "object"
    },
    "CropTask": {
      "additionalProperties": false,
      "properties": {
        "crew_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Crew Id",
          "type": "string"
        },
        "task": {
          "enum": [
            "harvest",
            "clear"
          ],
          "title": "Task",
          "type": "string"
        },
        "plot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plot Id",
          "type": "string"
        }
      },
      "required": [
        "crew_id",
        "task",
        "plot_id"
      ],
      "title": "CropTask",
      "type": "object"
    },
    "DiscussionContent": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "world": {
          "$ref": "#/$defs/CoreWorld"
        },
        "rules": {
          "additionalProperties": true,
          "title": "Rules",
          "type": "object"
        },
        "previous_messages": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Previous Messages",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "response_guidance": {
          "title": "Response Guidance",
          "type": "string"
        },
        "analysis_scope": {
          "items": {
            "type": "string"
          },
          "title": "Analysis Scope",
          "type": "array"
        },
        "unit_conversion_policy": {
          "title": "Unit Conversion Policy",
          "type": "string"
        },
        "explanation_schema": {
          "additionalProperties": true,
          "title": "Explanation Schema",
          "type": "object"
        },
        "current_plan": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Plan"
        }
      },
      "required": [
        "question",
        "world",
        "rules",
        "previous_messages",
        "reason",
        "response_guidance",
        "analysis_scope",
        "unit_conversion_policy",
        "explanation_schema"
      ],
      "title": "DiscussionContent",
      "type": "object"
    },
    "Drink": {
      "additionalProperties": false,
      "properties": {
        "crew_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Crew Id",
          "type": "string"
        },
        "task": {
          "const": "drink",
          "title": "Task",
          "type": "string"
        },
        "amount": {
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        }
      },
      "required": [
        "crew_id",
        "task",
        "amount"
      ],
      "title": "Drink",
      "type": "object"
    },
    "Eat": {
      "additionalProperties": false,
      "properties": {
        "crew_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Crew Id",
          "type": "string"
        },
        "task": {
          "const": "eat",
          "title": "Task",
          "type": "string"
        },
        "amount": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        }
      },
      "required": [
        "crew_id",
        "task",
        "amount"
      ],
      "title": "Eat",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "type": "string"
          },
          "title": "Observations",
          "type": "array"
        },
        "proposals": {
          "items": {
            "$ref": "#/$defs/PublicProposal"
          },
          "title": "Proposals",
          "type": "array"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/Review"
          },
          "title": "Reviews",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "follow_up_reason": {
          "title": "Follow Up Reason",
          "type": "string"
        },
        "decision_reason": {
          "title": "Decision Reason",
          "type": "string"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "observations",
        "proposals",
        "reviews",
        "conflicts",
        "follow_up_reason",
        "decision_reason",
        "uncertainties"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "Generate": {
      "additionalProperties": false,
      "properties": {
        "crew_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Crew Id",
          "type": "string"
        },
        "task": {
          "const": "generate",
          "title": "Task",
          "type": "string"
        },
        "work_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Work Fraction",
          "type": "number"
        }
      },
      "required": [
        "crew_id",
        "task",
        "work_fraction"
      ],
      "title": "Generate",
      "type": "object"
    },
    "Idle": {
      "additionalProperties": false,
      "properties": {
        "crew_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Crew Id",
          "type": "string"
        },
        "task": {
          "const": "idle",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "crew_id",
        "task"
      ],
      "title": "Idle",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "for_tick": {
          "minimum": 1,
          "title": "For Tick",
          "type": "integer"
        },
        "crew_tasks": {
          "items": {
            "discriminator": {
              "mapping": {
                "clear": "#/$defs/CropTask",
                "drink": "#/$defs/Drink",
                "eat": "#/$defs/Eat",
                "generate": "#/$defs/Generate",
                "harvest": "#/$defs/CropTask",
                "idle": "#/$defs/Idle",
                "plant": "#/$defs/Plant"
              },
              "propertyName": "task"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Idle"
              },
              {
                "$ref": "#/$defs/Eat"
              },
              {
                "$ref": "#/$defs/Drink"
              },
              {
                "$ref": "#/$defs/Generate"
              },
              {
                "$ref": "#/$defs/CropTask"
              },
              {
                "$ref": "#/$defs/Plant"
              }
            ]
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Crew Tasks",
          "type": "array"
        },
        "refill_order": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Refill Order",
          "type": "array"
        },
        "water_production_request_liters": {
          "minimum": 0,
          "title": "Water Production Request Liters",
          "type": "number"
        },
        "irrigation_allocations": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Allocation"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Irrigation Allocations"
        },
        "crop_operation_order": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Crop Operation Order",
          "type": "array"
        }
      },
      "required": [
        "for_tick",
        "crew_tasks",
        "refill_order",
        "water_production_request_liters",
        "irrigation_allocations",
        "crop_operation_order"
      ],
      "title": "Plan",
      "type": "object"
    },
    "Plant": {
      "additionalProperties": false,
      "properties": {
        "crew_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Crew Id",
          "type": "string"
        },
        "task": {
          "const": "plant",
          "title": "Task",
          "type": "string"
        },
        "plot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plot Id",
          "type": "string"
        },
        "crop_type": {
          "enum": [
            "lettuce",
            "potato",
            "tomato",
            "wheat",
            "soybean"
          ],
          "title": "Crop Type",
          "type": "string"
        }
      },
      "required": [
        "crew_id",
        "task",
        "plot_id",
        "crop_type"
      ],
      "title": "Plant",
      "type": "object"
    },
    "PublicProposal": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "expected_effect": {
          "title": "Expected Effect",
          "type": "string"
        },
        "tradeoffs": {
          "items": {
            "type": "string"
          },
          "title": "Tradeoffs",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "proposal_id",
        "strategy",
        "reason",
        "expected_effect",
        "tradeoffs",
        "evidence"
      ],
      "title": "PublicProposal",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "water": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Water"
        },
        "oxygen": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Oxygen"
        },
        "food": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Food"
        },
        "power": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Power"
        }
      },
      "required": [
        "water",
        "oxygen",
        "food",
        "power"
      ],
      "title": "Resources",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "proposal_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "accept",
            "modify",
            "reject",
            "needs_clarification"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "assessment": {
          "title": "Assessment",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "proposal_id",
        "disposition",
        "assessment"
      ],
      "title": "Review",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "message_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "discussion_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Discussion Id",
      "type": "string"
    },
    "round": {
      "maximum": 3,
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "sender": {
      "const": "core",
      "title": "Sender",
      "type": "string"
    },
    "recipient": {
      "const": "human",
      "title": "Recipient",
      "type": "string"
    },
    "world_version": {
      "minimum": 0,
      "title": "World Version",
      "type": "integer"
    },
    "display_text": {
      "title": "Display Text",
      "type": "string"
    },
    "explanation": {
      "$ref": "#/$defs/Explanation"
    },
    "content": {
      "$ref": "#/$defs/DiscussionContent"
    },
    "detail_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail Text"
    }
  },
  "required": [
    "message_id",
    "discussion_id",
    "round",
    "sender",
    "recipient",
    "world_version",
    "display_text",
    "explanation",
    "content"
  ],
  "title": "DiscussionRequest",
  "type": "object"
}