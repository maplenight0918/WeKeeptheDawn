        "proposal_id",
        "proposal_kind",
        "target_crew_ids",
        "proposed_changes",
        "reason",
        "constraints",
        "coordination_needed",
        "feasibility",
        "rule_ids",
        "evidence_ids",
        "audit_result_id",
        "expected_effect"
