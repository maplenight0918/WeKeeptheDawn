            "evaluated",
            "not_reached",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "status",
        "details"
      ],
      "title": "Stage",
      "type": "object"
    }
