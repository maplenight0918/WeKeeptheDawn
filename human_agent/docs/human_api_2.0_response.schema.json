          "title": "Target Crew Ids",
          "type": "array"
        },
        "proposed_changes": {
          "additionalProperties": true,
          "title": "Proposed Changes",
          "type": "object"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "coordination_needed": {
          "title": "Coordination Needed",
          "type": "boolean"
