        "dimensions": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dimensions"
        },
        "ranking_method": {
          "default": "none",
          "title": "Ranking Method",
          "type": "string"
        }
      },
      "required": [
        "requested_mode",
        "actual_mode",
        "fallback_reason",
        "model",
        "dimensions"
      ],
      "title": "RetrievalInfo",
      "type": "object"
    },
