        "after_refill": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Refill"
        },
        "after_base": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Base"
        },
        "actual_work": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual Work"
        },
        "fatal_conditions": {
          "items": {
            "$ref": "#/$defs/FatalCondition"
          },
          "title": "Fatal Conditions",
          "type": "array"
        }
      },
      "required": [
        "crew_id",
        "alive",
        "food_energy",
        "water",
        "energy_ratio",
        "water_ratio",
        "low_flags",
        "idle_no_refill",
        "requested_work_no_refill",
        "after_refill",
        "after_base",
        "actual_work",
        "fatal_conditions"
      ],
      "title": "CrewAssessment",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "world_rule",
            "scientific_source",
            "implementation_assumption"
          ],
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Chunk Id"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Id"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "verification_status": {
          "title": "Verification Status",
          "type": "string"
        },
        "reviewed_claims": {
          "items": {
            "type": "string"
          },
          "title": "Reviewed Claims",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "document_id",
        "chunk_id",
        "rule_id",
        "locator",
        "source_url",
        "excerpt",
        "verification_status"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FatalCondition": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "trigger_values": {
          "additionalProperties": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Trigger Values",
          "type": "object"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "resource",
        "phase",
        "trigger_values",
        "rule_ids"
      ],
      "title": "FatalCondition",
      "type": "object"
    },
    "Horizon": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "already_failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "continuous_margin_ticks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Continuous Margin Ticks"
        },
        "first_fatal_tick_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Fatal Tick Offset"
        },
        "safe_complete_ticks": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Safe Complete Ticks"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "status",
        "continuous_margin_ticks",
        "first_fatal_tick_offset",
        "safe_complete_ticks",
        "assumptions"
      ],
      "title": "Horizon",
      "type": "object"
    },
    "LedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "kind": {
          "enum": [
            "transfer",
            "consumption",
            "production",
            "overflow"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        }
      },
      "required": [
        "phase",
        "kind",
        "resource",
        "entity_id",
        "amount"
      ],
      "title": "LedgerEntry",
      "type": "object"
    },
    "Margins": {
      "additionalProperties": false,
      "properties": {
        "energy": {
          "$ref": "#/$defs/Horizon"
        },
        "water": {
          "$ref": "#/$defs/Horizon"
        },
        "energy_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Energy Rate"
        },
        "water_rate": {
          "minimum": 0,
          "title": "Water Rate",
          "type": "number"
        }
      },
      "required": [
        "energy",
        "water",
        "energy_rate",
        "water_rate"
      ],
      "title": "Margins",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
