{
  "$defs": {
    "Audit": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "title": "Result Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "feasible_in_scope",
            "fatal_in_scope",
            "unsafe_in_scope",
            "incomplete",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "for_tick": {
          "title": "For Tick",
          "type": "integer"
        },
        "coverage_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coverage End"
        },
        "fatal_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fatal Stage"
        },
        "stage_results": {
          "additionalProperties": {
            "$ref": "#/$defs/Stage"
          },
          "title": "Stage Results",
          "type": "object"
        },
        "ledger": {
          "items": {
            "$ref": "#/$defs/LedgerEntry"
          },
          "title": "Ledger",
          "type": "array"
        },
        "known_after_values": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Known After Values"
        },
        "fatal_conditions": {
          "items": {
            "$ref": "#/$defs/FatalCondition"
          },
          "title": "Fatal Conditions",
          "type": "array"
        },
        "unknown_dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Dependencies",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "status",
        "scope",
        "for_tick",
        "coverage_end",
        "fatal_stage",
        "stage_results",
        "ledger",
        "known_after_values",
        "fatal_conditions",
        "unknown_dependencies",
        "limitations"
      ],
      "title": "Audit",
      "type": "object"
    },
    "CrewAssessment": {
